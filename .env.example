# ==============================================================================
# InfraPulse Environment Configuration Template
# ==============================================================================

# --- Application Settings ---
PROJECT_NAME=InfraPulse
ENVIRONMENT=development
API_V1_STR=/api/v1

# --- Security & Agent Authentication ---
# Secret token that all client agents (Ubuntu/Windows) must supply in the X-Agent-Token header
AGENT_SECRET_TOKEN=infrapulse_secret_token_change_in_production

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=infrapulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Direct Database URL (used by SQLAlchemy in backend)
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/infrapulse

# --- Email Alert (SMTP) Configuration ---
# Example for Gmail: Use SMTP port 587 with a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=alerts@infrapulse.local
DEFAULT_ALERT_RECIPIENT=your_alert_receiver@gmail.com
